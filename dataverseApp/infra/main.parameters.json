{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "connectorNamespaceLocation": {
      "value": "${CONNECTOR_NAMESPACE_LOCATION=westcentralus}"
    },
    "userPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "dataverseEnvironmentUrl": {
      "value": "${DATAVERSE_ENVIRONMENT_URL=}"
    },
    "dataverseEnvironmentName": {
      "value": "${DATAVERSE_ENVIRONMENT_NAME=}"
    },
    "dataverseTableName": {
      "value": "${DATAVERSE_TABLE_NAME=accounts}"
    }
  }
}

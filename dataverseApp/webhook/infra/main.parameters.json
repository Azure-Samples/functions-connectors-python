{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "telemetryLocation": { "value": "${TELEMETRY_LOCATION=}" },
    "connectorNamespaceLocation": { "value": "${CONNECTOR_NAMESPACE_LOCATION=westcentralus}" },
    "userPrincipalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "dataverseEnvironmentUrl": { "value": "${DATAVERSE_ENVIRONMENT_URL}" },
    "dataverseTableName": { "value": "${DATAVERSE_TABLE_NAME=account}" },
    "enableSeparateRowTriggers": { "value": "${DATAVERSE_ENABLE_SEPARATE_ROW_TRIGGERS=false}" },
    "dataverseEntitySetName": { "value": "${DATAVERSE_ENTITY_SET_NAME=accounts}" },
    "enableActionTrigger": { "value": "${DATAVERSE_ENABLE_ACTION_TRIGGER=false}" },
    "eventCatalog": { "value": "${DATAVERSE_EVENT_CATALOG=}" },
    "eventCategory": { "value": "${DATAVERSE_EVENT_CATEGORY=}" },
    "eventTable": { "value": "${DATAVERSE_EVENT_TABLE=}" },
    "eventAction": { "value": "${DATAVERSE_EVENT_ACTION=}" }
  }
}